# Configuración de la demo. Cualquier valor se puede pisar con una variable de entorno,
# por ejemplo: BUCKET=g10-demo-datos-2 ./demo/setup.sh

# Dónde corre la demo:
#   floci = AWS emulado localmente con Floci en Docker (sin cuenta, sin costo, sin Internet).
#   aws   = una cuenta real de AWS, aislada y con alerta de presupuesto.
: "${MODO:=floci}"

# El nombre de un bucket es único en todo AWS: si está ocupado, agregar un sufijo.
: "${BUCKET:=g10-demo-datos}"
: "${REGION:=us-east-1}"

# Solo MODO=aws: perfil de AWS CLI con permisos de administrador en la cuenta AISLADA de la demo.
# Vacío = usar las credenciales por defecto del entorno.
: "${AWS_PROFILE_ADMIN:=}"

# Solo MODO=floci
: "${FLOCI_IMAGE:=floci/floci:2.3.0}"
: "${FLOCI_PUERTO:=4566}"

: "${USUARIO_APP:=g10-app}"
: "${ROL_LECTURA:=g10-app-lectura}"

# Si gitleaks o prowler no están instalados, se usan estas imágenes de Docker.
: "${GITLEAKS_IMAGE:=zricethezav/gitleaks:v8.21.2}"
: "${PROWLER_IMAGE:=prowlercloud/prowler:stable}"

# 1 = esperar Enter entre pasos (en vivo). 0 = correr de corrido (ensayo o grabación).
: "${PAUSA:=1}"
